<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleGetInfoString</key>
	<string>MM_COPYRIGHT</string>
	<key>CFBundleIconFile</key>
	<string>MenuMeters.icns</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>MM_VERSION</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<!-- Sortable build number, not the displayed version. See
	     InfoPlistPreprocessor.h for why these two differ. -->
	<key>CFBundleVersion</key>
	<string>MM_BUILD</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSAppleEventsUsageDescription</key>
	<string>This is to control the Activity Monitor to open specific panes such as memory or network. Another alert might be shown soon afterwards.</string>
	<key>NSMainNibFile</key>
	<string>MenuMetersMainMenu</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>MenuMeters only uses the network to POST your metrics to the reporting URL you configure yourself. Nothing is sent anywhere else, and nothing is sent at all until you set that URL.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- The only outbound request this app makes is to the reporting URL the
		     user types in themselves. That is very often a plain-http endpoint on
		     the local network (a home server, an InfluxDB box, a Pi), which is
		     what NSAllowsLocalNetworking permits: loopback, *.local, unqualified
		     hostnames, and the private/link-local IP ranges.

		     NSAllowsArbitraryLoads is deliberately NOT set. It used to be, which
		     disabled ATS for every host and meant the optional auth header could
		     be POSTed in cleartext to a public-internet endpoint with no warning.
		     A reporting URL outside the local network must now be https://.
		     MenuMeterReporter rejects such a URL up front with an explanation,
		     rather than letting it fail as an opaque ATS error. -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
